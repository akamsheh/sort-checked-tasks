{
	"name": "sort-checked-tasks",
	"version": "0.2.1",
	"description": "Obsidian plugin that moves checked checklist items to the bottom of their task group.",
	"author": "Adam Kamsheh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akamsheh/sort-checked-tasks.git"
	},
	"bugs": {
		"url": "https://github.com/akamsheh/sort-checked-tasks/issues"
	},
	"homepage": "https://github.com/akamsheh/sort-checked-tasks#readme",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": "^22.0.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "wdio run ./wdio.conf.mts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"checklist",
		"tasks"
	],
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.17",
		"@wdio/cli": "^9.30.0",
		"@wdio/globals": "^9.29.1",
		"@wdio/local-runner": "^9.30.0",
		"@wdio/mocha-framework": "^9.30.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"mocha": "^11.7.6",
		"obsidian": "1.4.11",
		"prettier": "3.9.4",
		"tsx": "^4.23.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.9",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	}
}
